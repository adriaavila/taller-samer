{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist-tests",
    "module": "CommonJS",
    "target": "ES2020",
    "noEmit": false,
    "isolatedModules": false,
    "moduleResolution": "node",
    "types": ["node"],
    "jsx": "react-jsx"
  },
  "include": ["tests/**/*.ts", "src/lib/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
